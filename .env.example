# ==============================================================
# AMBATUBOT - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Salin file ini menjadi .env lalu sesuaikan nilainya:
# cp .env.example .env
# ==============================================================

# Google Gemini AI API Key (Dapatkan gratis di https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Nomor WhatsApp Pemilik (Owner) Bot (format kode negara tanpa '+', contoh: 6281234567890)
OWNER_NUMBER=6281234567890

# Nomor WhatsApp Bot yang akan dipairing via 8 digit code
PAIRING_NUMBER=6281234567890

# Model Gemini yang digunakan (default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite
